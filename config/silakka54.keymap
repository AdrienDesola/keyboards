/*
 * Silakka54 keymap, ported from silakka54.vil (Vial).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
// |  `   |  1  |  2  |  3  |  4  |  5  |                  |  6  |  7  |  8  |  9  |  0  |  \   |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |                  |  Y  |  U  |  I  |  O  |  P  | BSPC |
// |CTL/ESC| A  |  S  |  D  |  F  |  G  |                  |  H  |  J  |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |                  |  N  |  M  |  ,  |  .  |  /  | SHFT |
//                    | ALT | GUI | SPC |                  |ENT/FN| FN | RALT|
            display-name = "Base";
            bindings = <
&kp GRAVE     &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                       &kp N6  &kp N7 &kp N8    &kp N9  &kp N0   &kp BSLH
&kp TAB       &kp Q  &kp W  &kp E    &kp R    &kp T                        &kp Y   &kp U  &kp I     &kp O   &kp P    &kp BSPC
&mt LCTRL ESC &kp A  &kp S  &kp D    &kp F    &kp G                        &kp H   &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT     &kp Z  &kp X  &kp C    &kp V    &kp B                        &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                            &kp LALT &kp LGUI &kp SPACE                    &lt 1 RET &mo 1 &kp RALT
            >;
        };

        fn_layer {
// | F11  | F1  | F2  | F3  | F4  | F5  |                  | F6  | F7  | F8  | F9  | F10 | F12  |
// | BOOT |     |     |     |     |     |                  |     |  -  |  =  |  [  |  ]  |      |
// |      |     |     |     |     |     |                  |  <- |  v  |  ^  |  -> |     |      |
// |BTCLR | BT0 | BT1 | BT2 | BT3 | BT4 |                  |USB/BLE|   |     |     |     |UNLOCK|
//                    |     |     |     |                  |     |     |     |
            display-name = "Fn";
            bindings = <
&kp F11    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                       &kp F6       &kp F7    &kp F8    &kp F9   &kp F10  &kp F12
&bootloader &trans      &trans       &trans       &trans       &trans                       &trans       &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &trans
&trans     &trans       &trans       &trans       &trans       &trans                       &kp LEFT     &kp DOWN  &kp UP    &kp RIGHT &trans  &trans
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                 &out OUT_TOG &trans    &trans    &trans   &trans   &studio_unlock
                                     &trans       &trans       &trans                       &trans       &trans    &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
